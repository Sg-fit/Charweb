[Unit]
Description=Charweb research testbed (Flask + SocketIO)
After=network.target

[Service]
Type=simple
User=charweb
Group=charweb
WorkingDirectory=/srv/charweb
EnvironmentFile=/etc/charweb.env

# Single process via Flask-SocketIO's eventlet server (see run_prod.py).
# We do NOT use gunicorn's eventlet worker: it fails to load against
# eventlet >= 0.38. One process also keeps server-side response time
# consistent, which feeds the page-load timings the study measures.
# stdout/stderr (incl. access logging) are captured by journald:
#   journalctl -u charweb
ExecStart=/srv/charweb/venv/bin/python /srv/charweb/run_prod.py

Restart=always
RestartSec=5
# Do NOT add memory/CPU limits here without recording it: throttling changes
# response time, which is a measured variable during collection.

[Install]
WantedBy=multi-user.target
